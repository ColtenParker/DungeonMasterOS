generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model World {
  id          String      @id @default(uuid(7)) @db.Uuid
  name        String      @db.VarChar(120)
  description String?     @db.VarChar(5000)
  isArchived  Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  campaigns   Campaign[]
  entries     Entry[]
  tags        Tag[]
  media       Media[]
  mapMarkers  MapMarker[]

  @@index([isArchived])
}

model Campaign {
  id          String             @id @default(uuid(7)) @db.Uuid
  worldId     String             @db.Uuid
  name        String             @db.VarChar(120)
  description String?            @db.VarChar(5000)
  isArchived  Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  world       World              @relation(fields: [worldId], references: [id], onDelete: Restrict)
  entries     Entry[]
  workspace   CampaignWorkspace?
  media       Media[]
  mapMarkers  MapMarker[]

  @@index([worldId, isArchived])
}

model CampaignWorkspace {
  id                String                 @id @default(uuid(7)) @db.Uuid
  campaignId        String                 @unique @db.Uuid
  backgroundMediaId String?                @db.Uuid
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  campaign          Campaign               @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  backgroundMedia   Media?                 @relation(fields: [backgroundMediaId], references: [id], onDelete: Restrict)
  windows           WorkspaceEntryWindow[]

  @@index([backgroundMediaId])
}

model WorkspaceEntryWindow {
  workspaceId String            @db.Uuid
  entryId     String            @db.Uuid
  x           Int
  y           Int
  width       Int
  height      Int
  zOrder      Int
  isMinimized Boolean           @default(false)
  workspace   CampaignWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  entry       Entry             @relation(fields: [entryId], references: [id], onDelete: Restrict)

  @@id([workspaceId, entryId])
  @@index([entryId])
}

enum EntryType {
  NPC
  LOCATION
  JOURNAL
  QUEST
  FACTION
  ITEM
}

enum MediaType {
  IMAGE
  MAP
}

model Entry {
  id                       String                   @id @default(uuid(7)) @db.Uuid
  type                     EntryType
  title                    String                   @db.VarChar(120)
  document                 Json
  documentVersion          Int                      @default(1)
  documentText             String                   @default("") @db.Text
  searchVector             Unsupported("tsvector")?
  worldId                  String?                  @db.Uuid
  campaignId               String?                  @db.Uuid
  isArchived               Boolean                  @default(false)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  world                    World?                   @relation(fields: [worldId], references: [id], onDelete: Restrict)
  campaign                 Campaign?                @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  outgoingRelationships    EntryRelationship[]      @relation("EntryRelationshipSource")
  incomingRelationships    EntryRelationship[]      @relation("EntryRelationshipTarget")
  outgoingInlineReferences EntryInlineReference[]   @relation("EntryInlineReferenceSource")
  incomingInlineReferences EntryInlineReference[]   @relation("EntryInlineReferenceTarget")
  tagAssignments           EntryTag[]
  workspaceWindows         WorkspaceEntryWindow[]
  mapMarkers               MapMarker[]
  sections                 EntrySection[]
  npcDetails               NpcDetails?              @relation("NpcEntry")
  currentNpcs              NpcDetails[]             @relation("NpcCurrentLocation")
  locationDetails          LocationDetails?         @relation("LocationEntry")
  childLocations           LocationDetails[]        @relation("LocationParent")
  questDetails             QuestDetails?
  factionDetails           FactionDetails?          @relation("FactionEntry")
  factionLeaderships       FactionLeader[]          @relation("FactionLeaderNpc")
  inventories              Inventory[]              @relation("InventoryOwner")
  inventoryLines           InventoryLine[]          @relation("InventoryItem")

  @@index([worldId, type, isArchived])
  @@index([campaignId, type, isArchived])
}

model EntrySection {
  entryId  String @db.Uuid
  key      String @db.VarChar(40)
  position Int
  entry    Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@id([entryId, key])
  @@unique([entryId, position])
}

model NpcDetails {
  entryId           String  @id @db.Uuid
  portraitMediaId   String? @db.Uuid
  status            String? @db.VarChar(80)
  currentLocationId String? @db.Uuid
  entry             Entry   @relation("NpcEntry", fields: [entryId], references: [id], onDelete: Cascade)
  portraitMedia     Media?  @relation(fields: [portraitMediaId], references: [id], onDelete: Restrict)
  currentLocation   Entry?  @relation("NpcCurrentLocation", fields: [currentLocationId], references: [id], onDelete: Restrict)

  @@index([portraitMediaId])
  @@index([currentLocationId])
  @@index([status])
}

model LocationDetails {
  entryId          String  @id @db.Uuid
  parentLocationId String? @db.Uuid
  sortOrder        Int     @default(0)
  entry            Entry   @relation("LocationEntry", fields: [entryId], references: [id], onDelete: Cascade)
  parentLocation   Entry?  @relation("LocationParent", fields: [parentLocationId], references: [id], onDelete: Restrict)

  @@index([parentLocationId, sortOrder])
}

model QuestDetails {
  entryId    String           @id @db.Uuid
  status     String?          @db.VarChar(80)
  entry      Entry            @relation(fields: [entryId], references: [id], onDelete: Cascade)
  objectives QuestObjective[]

  @@index([status])
}

model QuestObjective {
  id        String       @id @default(uuid(7)) @db.Uuid
  questId   String       @db.Uuid
  text      String       @db.VarChar(500)
  completed Boolean      @default(false)
  position  Int
  quest     QuestDetails @relation(fields: [questId], references: [entryId], onDelete: Cascade)

  @@unique([questId, position])
  @@index([questId])
}

model FactionDetails {
  entryId String          @id @db.Uuid
  status  String?         @db.VarChar(80)
  entry   Entry           @relation("FactionEntry", fields: [entryId], references: [id], onDelete: Cascade)
  leaders FactionLeader[]

  @@index([status])
}

model FactionLeader {
  id        String         @id @default(uuid(7)) @db.Uuid
  factionId String         @db.Uuid
  npcId     String         @db.Uuid
  role      String?        @db.VarChar(120)
  position  Int
  faction   FactionDetails @relation(fields: [factionId], references: [entryId], onDelete: Cascade)
  npc       Entry          @relation("FactionLeaderNpc", fields: [npcId], references: [id], onDelete: Restrict)

  @@unique([factionId, position])
  @@index([npcId])
}

model Inventory {
  id           String          @id @default(uuid(7)) @db.Uuid
  ownerEntryId String          @db.Uuid
  name         String          @db.VarChar(120)
  position     Int
  owner        Entry           @relation("InventoryOwner", fields: [ownerEntryId], references: [id], onDelete: Cascade)
  lines        InventoryLine[]

  @@unique([ownerEntryId, position])
  @@index([ownerEntryId])
}

model InventoryLine {
  id          String    @id @default(uuid(7)) @db.Uuid
  inventoryId String    @db.Uuid
  itemId      String    @db.Uuid
  quantity    Int
  note        String?   @db.VarChar(500)
  position    Int
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  item        Entry     @relation("InventoryItem", fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([inventoryId, position])
  @@index([itemId])
}

model Media {
  id                  String              @id @default(uuid(7)) @db.Uuid
  name                String              @db.VarChar(120)
  description         String?             @db.VarChar(5000)
  type                MediaType
  originalFilename    String              @db.VarChar(255)
  mimeType            String              @db.VarChar(100)
  byteSize            Int
  width               Int
  height              Int
  checksumSha256      String              @db.Char(64)
  originalStorageKey  String              @db.VarChar(500)
  displayStorageKey   String              @db.VarChar(500)
  thumbnailStorageKey String              @db.VarChar(500)
  worldId             String?             @db.Uuid
  campaignId          String?             @db.Uuid
  isArchived          Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  world               World?              @relation(fields: [worldId], references: [id], onDelete: Restrict)
  campaign            Campaign?           @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  workspaceBackground CampaignWorkspace[]
  markers             MapMarker[]
  npcPortraits        NpcDetails[]

  @@index([worldId, type, isArchived])
  @@index([campaignId, type, isArchived])
  @@index([checksumSha256])
}

model MapMarker {
  id         String    @id @default(uuid(7)) @db.Uuid
  mediaId    String    @db.Uuid
  entryId    String    @db.Uuid
  worldId    String?   @db.Uuid
  campaignId String?   @db.Uuid
  x          Decimal   @db.Decimal(10, 9)
  y          Decimal   @db.Decimal(10, 9)
  label      String?   @db.VarChar(120)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  media      Media     @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  entry      Entry     @relation(fields: [entryId], references: [id], onDelete: Restrict)
  world      World?    @relation(fields: [worldId], references: [id], onDelete: Restrict)
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  @@index([mediaId, worldId])
  @@index([mediaId, campaignId])
  @@index([entryId])
}

model EntryRelationship {
  id            String   @id @default(uuid(7)) @db.Uuid
  sourceEntryId String   @db.Uuid
  targetEntryId String   @db.Uuid
  contextNote   String?  @db.VarChar(1000)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sourceEntry   Entry    @relation("EntryRelationshipSource", fields: [sourceEntryId], references: [id], onDelete: Cascade)
  targetEntry   Entry    @relation("EntryRelationshipTarget", fields: [targetEntryId], references: [id], onDelete: Restrict)

  @@unique([sourceEntryId, targetEntryId])
  @@index([targetEntryId])
}

model EntryInlineReference {
  sourceEntryId String @db.Uuid
  targetEntryId String @db.Uuid
  sourceEntry   Entry  @relation("EntryInlineReferenceSource", fields: [sourceEntryId], references: [id], onDelete: Cascade)
  targetEntry   Entry  @relation("EntryInlineReferenceTarget", fields: [targetEntryId], references: [id], onDelete: Restrict)

  @@id([sourceEntryId, targetEntryId])
  @@index([targetEntryId])
}

model Tag {
  id             String     @id @default(uuid(7)) @db.Uuid
  worldId        String     @db.Uuid
  name           String     @db.VarChar(50)
  normalizedName String     @db.VarChar(50)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  world          World      @relation(fields: [worldId], references: [id], onDelete: Restrict)
  entries        EntryTag[]

  @@unique([worldId, normalizedName])
  @@index([worldId, name])
}

model EntryTag {
  entryId String @db.Uuid
  tagId   String @db.Uuid
  entry   Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([entryId, tagId])
  @@index([tagId])
}
