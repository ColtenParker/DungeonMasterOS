{
  "name": "@dmos/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "dev": "tsx watch src/server.ts",
    "e2e:server": "node scripts/start-test-server.mjs",
    "start": "node dist/server.js",
    "test": "vitest run --exclude **/*.integration.test.ts",
    "test:integration": "node scripts/migrate-test-database.mjs && vitest run --no-file-parallelism src/database.integration.test.ts src/world-campaign-store.integration.test.ts src/entry-store.integration.test.ts src/entry-knowledge-store.integration.test.ts src/campaign-workspace-store.integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "@tiptap/core": "^3.30.0",
    "@tiptap/starter-kit": "^3.30.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.14.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  }
}
